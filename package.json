{
  "name": "com.glenmorgan.pulsedeck",
  "version": "2.0.0-alpha.4",
  "description": "PulseDeck – Monitor HTTP health check endpoints from your Stream Deck",
  "private": true,
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "build:native": "bash native/build.sh",
    "watch": "rollup -c rollup.config.mjs --watch",
    "build:dev": "rollup -c rollup.config.mjs --sourcemap",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack": "streamdeck pack com.glenmorgan.pulsedeck.sdPlugin --force",
    "release": "npm run typecheck && npm test && npm run build && npm run build:native && npm run pack"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^25.9.1",
    "jsdom": "^29.1.1",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
